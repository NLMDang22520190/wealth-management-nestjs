# Local synthetic demo only. Copy to .env in the repository root.
NODE_ENV=development
MOCK_AUTH_ENABLED=true
PORT=3000
# Optional per-minute limits (positive integers): customer lookups per actor, onboarding invitations per RM.
# LOOKUP_RATE_LIMIT_PER_MINUTE=30
# INVITE_RATE_LIMIT_PER_MINUTE=10
# OTP lifetime in seconds (integer 1..900); invalid values stop startup with CONFIG_INVALID.
# OTP_TTL_SECONDS=120
# Demo PostgreSQL credentials match infra/compose.yml; never use them for a real database.
DATABASE_URL=postgresql://wms_demo:wms_demo_local_only@127.0.0.1:5432/wealth_management_demo
# Generate your own signing key, then paste it after JWT_SECRET= below:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Run: docker compose -f infra/compose.yml up -d
# Then: npm run seed:demo
# Then: npm run start:api
